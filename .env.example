# Copy this file to .env and fill in the real values locally.
# Never commit the .env file.

LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=gemini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
SERPAPI_KEY=
SERPAPI_CACHE_TTL_SECONDS=3600
SERPAPI_CACHE_MAX_ENTRIES=512

# Optional fast structured classifier. Leave the key empty to disable Jev and
# keep MarketSarthi's existing classification path.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_CLASSIFICATION_MIN_CONFIDENCE=0.65

# Optional fallback provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
APP_ENV=development
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

DATABASE_URL=sqlite:///./data/marketsarthi.db
FRONTEND_URL=http://localhost:3000
